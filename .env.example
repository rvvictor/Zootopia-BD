# Ejemplo de archivo .env para producción
# Copia este archivo a .env y completa con tus valores reales

# Supabase Configuration
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anonima_aqui

# IMPORTANTE:
# - Las variables DEBEN empezar con VITE_ para que Vite las reconozca
# - NO subas este archivo a Git (ya está en .gitignore)
# - Usa valores diferentes para desarrollo y producción si es necesario
